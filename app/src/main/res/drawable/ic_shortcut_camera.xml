<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive layers use a 108-unit canvas with a 72-unit visible mask.
     A 36-unit glyph preserves the original 54/108 = 50% visible ratio.
     Fractional insets scale with the launcher's drawable bounds. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/shortcut_background" />
    <foreground>
        <inset
            android:drawable="@drawable/ic_shortcut_camera_glyph"
            android:insetLeft="33.333333%"
            android:insetTop="33.333333%"
            android:insetRight="33.333333%"
            android:insetBottom="33.333333%" />
    </foreground>
</adaptive-icon>
