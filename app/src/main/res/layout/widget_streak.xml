<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_outer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingTop="36px"
    android:paddingBottom="42px">
<ImageView android:id="@+id/widget_background" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" android:src="@drawable/widget_chart_background" android:importantForAccessibility="no" />
<!-- Match NexioSchedule's 4x6 launcher spacing at its 480 dpi reference. -->
<LinearLayout android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:paddingStart="12dp" android:paddingEnd="12dp" android:paddingTop="12dp" android:paddingBottom="12dp">
<TextView android:id="@+id/widget_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/widget_streak_name" android:textSize="@dimen/widget_title_size" android:textColor="@color/widget_text" android:includeFontPadding="false"/>
<TextView android:id="@+id/widget_value" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/widget_zero" android:textSize="26sp" android:maxLines="1" android:autoSizeTextType="none" android:textColor="@color/widget_text" android:includeFontPadding="false"/>
<ImageView android:id="@+id/widget_chart" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="4dp" android:scaleType="fitXY" android:importantForAccessibility="no"/>
</LinearLayout>
</FrameLayout>
