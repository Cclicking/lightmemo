<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingTop="36px"
    android:paddingBottom="42px">
<!-- Match NexioSchedule's 4x6 launcher spacing at its 480 dpi reference. -->
<LinearLayout android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:paddingStart="12dp" android:paddingEnd="12dp" android:paddingTop="12dp" android:paddingBottom="12dp" android:background="@drawable/widget_chart_background">
<TextView android:id="@+id/widget_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/widget_intake_name" android:textSize="@dimen/widget_title_size" android:textColor="@color/widget_text" android:includeFontPadding="false"/>
<TextView android:id="@+id/widget_value" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/widget_zero" android:textSize="26sp" android:maxLines="1" android:autoSizeTextType="none" android:textColor="@color/widget_text" android:includeFontPadding="false"/>
<FrameLayout android:id="@+id/widget_chart_container" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="4dp">
<ImageView android:id="@+id/widget_chart" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" android:importantForAccessibility="no"/>
<LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:importantForAccessibility="no">
<TextView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="0.21" android:text="" android:includeFontPadding="false"/>
<LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="0.26" android:orientation="horizontal">
<TextView android:id="@+id/widget_protein_label" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="0.34" android:gravity="center_vertical" android:text="蛋白质" android:textSize="12sp" android:textColor="@color/widget_text" android:includeFontPadding="false"/>
<TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="0.66" android:text="" android:includeFontPadding="false"/>
</LinearLayout>
<LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="0.26" android:orientation="horizontal">
<TextView android:id="@+id/widget_carbs_label" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="0.34" android:gravity="center_vertical" android:text="碳水" android:textSize="12sp" android:textColor="@color/widget_text" android:includeFontPadding="false"/>
<TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="0.66" android:text="" android:includeFontPadding="false"/>
</LinearLayout>
<LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="0.26" android:orientation="horizontal">
<TextView android:id="@+id/widget_fat_label" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="0.34" android:gravity="center_vertical" android:text="脂肪" android:textSize="12sp" android:textColor="@color/widget_text" android:includeFontPadding="false"/>
<TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="0.66" android:text="" android:includeFontPadding="false"/>
</LinearLayout>
<TextView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="0.01" android:text="" android:includeFontPadding="false"/>
</LinearLayout>
</FrameLayout>
</LinearLayout>
</FrameLayout>
